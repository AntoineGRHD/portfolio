# Contact address shown in the contact section. Encoded at build time, never shipped as text.
# In CI it comes from the CONTACT_EMAIL repository secret.
CONTACT_EMAIL=you@example.com

# "true" shows the CV download link in the contact section. The PDFs are published either
# way, reachable by direct URL. In CI it comes from the SHOW_CV_DOWNLOAD repository variable.
SHOW_CV_DOWNLOAD=false
